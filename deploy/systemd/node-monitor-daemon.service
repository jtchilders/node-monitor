[Unit]
Description=node-monitor collector daemon
# No Requires=: the daemon tolerates the database being absent and spools until it returns.
After=network-online.target pbs-postgres.service
Wants=network-online.target
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/node-monitor
Environment=PATH=%h/node-monitor/venv/bin:/usr/local/bin:/usr/bin:/bin
# The leading "-" lets the daemon start even if the database stays down.
ExecStartPre=-%h/node-monitor/venv/bin/node-monitor database wait --timeout 60
ExecStart=%h/node-monitor/venv/bin/node-monitor daemon start --foreground
Restart=always
RestartSec=15
TimeoutStopSec=90
KillMode=mixed
StandardOutput=append:%h/node-monitor/logs/daemon.log
StandardError=append:%h/node-monitor/logs/daemon.log

[Install]
WantedBy=default.target
